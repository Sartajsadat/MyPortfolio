# Copy to .env and fill in as needed. All variables are optional.

# Base path for deployment. Use "/" for a custom domain or user site,
# or "/MyPortfolio/" for GitHub Pages project sites.
VITE_BASE=/

# Public URL of the deployed site (used for SEO canonical / Open Graph tags).
VITE_SITE_URL=https://sartajsadat.github.io/MyPortfolio/

# Contact form endpoint. Any service that accepts a JSON POST works:
# Formspree (https://formspree.io/f/xxxx), a Spring Boot endpoint, etc.
# When empty, the form falls back to opening the visitor's email client.
VITE_CONTACT_ENDPOINT=

# Optional: base URL of a future Spring Boot content API. When set, the site
# fetches GET {VITE_API_BASE_URL}/api/content/{projects|experience|...}
# and falls back to the local data files if the request fails.
VITE_API_BASE_URL=
